; CRYSTAL native GBC canonical registry ABI
; Stage 1: all proven legacy Species/Move/Item table reads are redirected
; into ROM bank $81 while legacy runtime IDs remain u8.
;
; Stage 2 and later widen runtime identity access without moving these
; canonical registry entry points.

DEF CRYSTAL_REGISTRY_ABI_VERSION EQU 1

DEF CRYSTAL_REGISTRY_BANK EQU $81
DEF CRYSTAL_REGISTRY_BANK_BYTES EQU $4000
DEF CRYSTAL_REGISTRY_DIRECTORY_OFFSET EQU $0040
DEF CRYSTAL_REGISTRY_ENTRY_BYTES EQU 16
DEF CRYSTAL_REGISTRY_DATA_OFFSET EQU $0100

DEF CRYSTAL_REGISTRY_SPECIES EQU 1
DEF CRYSTAL_REGISTRY_MOVES   EQU 2
DEF CRYSTAL_REGISTRY_ITEMS   EQU 3

DEF CRYSTAL_REGISTRY_ID_BITS EQU 16

DEF CRYSTAL_BASE_DATA_ENTRY_BYTES EQU 32
DEF CRYSTAL_BASE_DATA_COUNT EQU 251
DEF CRYSTAL_BASE_DATA_ADDR EQU $4100
DEF CRYSTAL_BASE_DATA_BYTES EQU CRYSTAL_BASE_DATA_ENTRY_BYTES * CRYSTAL_BASE_DATA_COUNT

DEF CRYSTAL_MOVE_ENTRY_BYTES EQU 7
DEF CRYSTAL_MOVE_COUNT EQU 251
DEF CRYSTAL_MOVES_ADDR EQU $6060
DEF CRYSTAL_MOVES_BYTES EQU CRYSTAL_MOVE_ENTRY_BYTES * CRYSTAL_MOVE_COUNT

DEF CRYSTAL_ITEM_ATTR_ENTRY_BYTES EQU 7
DEF CRYSTAL_ITEM_ATTR_COUNT EQU 256
DEF CRYSTAL_ITEM_ATTRIBUTES_ADDR EQU $673d
DEF CRYSTAL_ITEM_ATTRIBUTES_BYTES EQU CRYSTAL_ITEM_ATTR_ENTRY_BYTES * CRYSTAL_ITEM_ATTR_COUNT

DEF CRYSTAL_REGISTRY_USED_BYTES EQU $2e3d
DEF CRYSTAL_REGISTRY_FREE_BYTES EQU CRYSTAL_REGISTRY_BANK_BYTES - CRYSTAL_REGISTRY_USED_BYTES

ASSERT CRYSTAL_MOVES_ADDR == CRYSTAL_BASE_DATA_ADDR + CRYSTAL_BASE_DATA_BYTES
ASSERT CRYSTAL_ITEM_ATTRIBUTES_ADDR == CRYSTAL_MOVES_ADDR + CRYSTAL_MOVES_BYTES
ASSERT CRYSTAL_REGISTRY_USED_BYTES == $0100 + CRYSTAL_BASE_DATA_BYTES + CRYSTAL_MOVES_BYTES + CRYSTAL_ITEM_ATTRIBUTES_BYTES
ASSERT CRYSTAL_REGISTRY_FREE_BYTES == 4547
